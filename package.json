{
  "name": "xivizley",
  "version": "1.0.0",
  "description": "XIVIZLEY Industrial Server & Cloud Ecosystem Interactive CLI Engine",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "xivizley": "./bin/xivizley.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
